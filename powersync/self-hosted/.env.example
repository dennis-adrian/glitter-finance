# Copy to .env on the server (never commit it) and fill in. docker compose
# reads it from this directory.

# The public hostname devices connect to, with a DNS A (and AAAA) record
# pointing at this server. NEXT_PUBLIC_POWERSYNC_URL is https://<this>.
PS_DOMAIN=sync.example.com

# Supabase direct connection as powersync_role (README "PowerSync setup").
# Use the db.<project-ref>.supabase.co host on port 5432, not the pooler.
# URL-encode the password if it has special characters.
PS_SOURCE_URI=postgresql://powersync_role:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# Password for the bucket storage Postgres that runs on this server.
# Generate one: openssl rand -hex 24
PS_STORAGE_PASSWORD=CHANGE_ME

# Prefix of the replication slots this instance creates on Supabase. One per
# instance and environment; letters, digits and underscores, ending in "_".
PS_SLOT_NAME_PREFIX=glitter_selfhost_

# API containers. Each takes up to 150 connections (service.yaml) and about
# 600 MB of memory; 3 fit a 4 GB server next to everything else.
PS_API_REPLICAS=3
