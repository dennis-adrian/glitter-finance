NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional locally and on Vercel preview (branch URLs come from VERCEL_*).
# Set on production when using a custom domain, e.g. https://pos.example.com
NEXT_PUBLIC_APP_URL=
# Optional locally — leave empty to use Supabase server actions only (no offline sync).
# Required for staging/production; see README PowerSync setup.
NEXT_PUBLIC_POWERSYNC_URL=
# Optional DSN override. Production defaults to the Glitter Sentry project.
NEXT_PUBLIC_SENTRY_DSN=

SUPABASE_SECRET_KEY=
# Dedicated secret for invitation token hashing and delivery encryption.
INVITATION_SECRET_KEY=
DATABASE_URL=

# Build-only Sentry values used to create releases and upload source maps.
# Org/project are optional because next.config.ts contains this project's defaults.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional — only needed to run the QA seed script (`npm run db:seed:qa`).
# Credentials for the dummy QA account it creates/refreshes.
QA_EMAIL=
QA_PASSWORD=
